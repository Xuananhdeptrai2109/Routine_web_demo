# ---------------------------
# Environment presets
# ---------------------------
# Local:    http://localhost:3000 / http://localhost:5001
# Staging:  https://staging-your-app.vercel.app / https://staging-api-your-app.vercel.app
# Production: https://your-app.vercel.app / https://your-api-domain.com

# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/routine_db"

# JWT Authentication
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Frontend URL for CORS and redirect links
FRONTEND_URL="http://localhost:3000"

# Public site URL for frontend (used by Next.js client-side URL generation)
# Example for Vercel production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Backend base URL (for frontend to call backend API)
# Example for Vercel production: https://your-backend-api.vercel.app
NEXT_PUBLIC_API_URL="http://localhost:5001"

# Google Gemini AI Integration (Future / Upcoming)
GEMINI_API_KEY="your_gemini_api_key_here"

# Gmail SMTP (dùng Gmail App Password, không dùng mật khẩu Gmail thường)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM='"Routine Fashion" <your-gmail@gmail.com>'

# VNPay Sandbox Configuration
VNP_TMN_CODE="your-vnpay-tmn-code"
VNP_HASH_SECRET="your-vnpay-hash-secret"
VNP_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNP_API_URL="https://sandbox.vnpayment.vn/merchant_webapi/api/transaction"
VNP_RETURN_URL="http://localhost:3000/checkout/payment/vnpay-return"
